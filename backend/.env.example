# ==============================================================================
# EduManage Backend Configuration Template
# ==============================================================================

# MongoDB Connection URI (Local default or MongoDB Atlas cluster connection string)
MONGO_URI=mongodb://localhost:27017/
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# Database Name
DB_NAME=student_management

# Test Database Name (for running automated tests safely in isolation)
TEST_DB_NAME=student_management_test

# Flask Application Settings
FLASK_ENV=development
PORT=5000
HOST=127.0.0.1

# Security & Session Token Secret Key (Change to a unique random string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Email (SMTP) Dispatch Configuration
# Public contact inquiries will be routed to ADMIN_NOTIFICATION_EMAIL
ADMIN_NOTIFICATION_EMAIL=admin@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# For live email delivery, use your Gmail and a 16-character Google App Password:
# (Google Account > Security > 2-Step Verification > App Passwords)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password

# Optional Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
